<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ariadne Professional Penetration Test Report</title>
<link rel="stylesheet" href="styles.css">
</head>
<body>
<div class="report-container">

<header class="cover-page">
<h1>Penetration Test Report</h1>
<p class="subtitle">Generated by Ariadne v0.2.0</p>
<table class="meta-table">
  <tr><th>Classification</th><td>{{ classification }}</td></tr>
  <tr><th>Version</th><td>{{ report_version }}</td></tr>
  <tr><th>Date</th><td>{{ generated_at }}</td></tr>
  <tr><th>Engagement ID</th><td><code>{{ engagement_id }}</code></td></tr>
</table>
</header>

<section class="contacts-disclaimer">
<h2>Contacts and Disclaimer</h2>
<div class="disclaimer">
<p>{{ disclaimer }}</p>
</div>
</section>

<section class="executive-summary">
<h2>Executive Summary</h2>
<p>{{ executive_summary }}</p>
</section>

<section class="objectives-scope-limitations">
<h2>Objectives, Scope, and Limitations</h2>
<h3>Scope</h3>
<ul>
{% for t in targets %}
<li><code>{{ t.host }}</code></li>
{% endfor %}
</ul>
<h3>Objectives</h3>
<ul>
{% for o in objectives %}
<li><strong>{{ o.kind }}</strong>: {{ o.description }}</li>
{% endfor %}
</ul>
<h3>Profile</h3>
<p>{{ profile }}</p>
</section>

<section class="methodology">
<h2>Methodology</h2>
<p>{{ methodology }}</p>
</section>

<section class="risk-summary">
<h2>Risk Summary</h2>
<table class="risk-table">
<thead>
  <tr><th>Severity</th><th>Count</th></tr>
</thead>
<tbody>
  <tr><td>Critical</td><td>{{ risk_counts.critical }}</td></tr>
  <tr><td>High</td><td>{{ risk_counts.high }}</td></tr>
  <tr><td>Medium</td><td>{{ risk_counts.medium }}</td></tr>
  <tr><td>Low</td><td>{{ risk_counts.low }}</td></tr>
  <tr><td>Informational</td><td>{{ risk_counts.informational }}</td></tr>
</tbody>
</table>
</section>

<section class="finding-table">
<h2>Finding Table</h2>
<table class="findings-table">
<thead>
  <tr><th>#</th><th>Title</th><th>Severity</th><th>Status</th></tr>
</thead>
<tbody>
{% if findings %}
{% for f in findings %}
<tr>
  <td>{{ loop.index }}</td>
  <td>{{ f.title }}</td>
  <td class="severity-{{ f.severity or 'unspecified' }}">{{ f.severity or 'unspecified' }}</td>
  <td>{{ f.status }}</td>
</tr>
{% endfor %}
{% else %}
<tr><td colspan="4">No reportable findings were persisted.</td></tr>
{% endif %}
</tbody>
</table>
</section>

<section class="compromise-narrative">
<h2>Compromise Narrative</h2>
{% if compromise_narrative %}
<ol>
{% for step in compromise_narrative %}
<li><strong>{{ step.event_type }}</strong>: {{ step.summary }}</li>
{% endfor %}
</ol>
{% else %}
<p>No compromise lifecycle was persisted.</p>
{% endif %}
</section>

<section class="technical-findings">
<h2>Technical Findings</h2>
{% if findings %}
{% for f in findings %}
<article class="finding-detail">
<h3>Finding {{ loop.index }}: {{ f.title }}</h3>
<table class="finding-meta">
  <tr><th>Severity</th><td class="severity-{{ f.severity or 'unspecified' }}">{{ f.severity or 'unspecified' }}</td></tr>
  <tr><th>Status</th><td>{{ f.status }}</td></tr>
  <tr><th>Target</th><td>{% if f.target %}<code>{{ f.target }}</code>{% else %}unspecified{% endif %}</td></tr>
</table>
{% if f.description %}
<p>{{ f.description }}</p>
{% else %}
<p>No description was persisted for this finding.</p>
{% endif %}
{% if f.evidence %}
<h4>Evidence</h4>
<ul>
{% for e in f.evidence %}
  <li><code>{{ e }}</code></li>
{% endfor %}
</ul>
{% endif %}
{% if f.remediation %}
<h4>Finding Remediation</h4>
<ul>
{% for item in f.remediation %}
  <li>{{ item }}</li>
{% endfor %}
</ul>
{% endif %}
</article>
{% endfor %}
{% else %}
<p>No reportable findings were persisted.</p>
{% endif %}
</section>

<section class="evidence">
<h2>Evidence Inventory</h2>
{% if evidence %}
<table>
<thead><tr><th>Artifact</th><th>SHA-256</th><th>Bytes</th></tr></thead>
<tbody>
{% for e in evidence %}
<tr><td><code>{{ e.filename }}</code></td><td><code>{{ e.sha256 }}</code></td><td>{{ e.size_bytes }}</td></tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p>No event-backed evidence artifacts were persisted.</p>
{% endif %}
</section>

<section class="remediation">
<h2>Remediation</h2>
{% if remediation %}
<ol>
{% for r in remediation %}
<li>{{ r }}</li>
{% endfor %}
</ol>
{% else %}
<p>No remediation actions were persisted.</p>
{% endif %}
</section>

<section class="compromised-hosts">
<h2>Compromised Hosts / Users</h2>
{% if compromised %}
<ul>
{% for c in compromised %}
<li>{{ c }}</li>
{% endfor %}
</ul>
{% else %}
<p>No compromised host or user records were persisted.</p>
{% endif %}
</section>

<section class="objective-evidence">
<h2>Objective Evidence</h2>
<ul>
{% for o in objectives %}
<li>
  <strong>{{ o.kind }}:</strong> {{ o.description }}
  {% if o.completed %}
  <span class="achieved">&#10003; Achieved</span>
  {% endif %}
</li>
{% endfor %}
</ul>
</section>

<section class="cleanup">
<h2>Cleanup Verification</h2>
{% if cleanup %}
<ul>
{% for item in cleanup %}
<li>{{ item }}</li>
{% endfor %}
</ul>
{% else %}
<p>No cleanup verification was persisted.</p>
{% endif %}
</section>

<section class="scoring-appendices">
<h2>Scoring Appendices</h2>
<p>{{ scoring_notes }}</p>
</section>

<footer>
<p>Authorized use only.</p>
<p>Engagement ID: <code>{{ engagement_id }}</code></p>
</footer>

</div>
</body>
</html>
